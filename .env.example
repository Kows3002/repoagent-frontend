# Development: Vite forwards /jobs and /auth to your local backend.
API_PROXY_TARGET=http://127.0.0.1:8000

# Production: leave empty when /jobs and /auth share the frontend origin.
# An absolute API URL requires credentialed CORS and compatible session cookies.
VITE_API_BASE_URL=

# Must match the backend PREVIEW_DOMAIN, PREVIEW_SCHEME, and PREVIEW_PORT.
# Production example: https://*.preview.example.com
VITE_PREVIEW_ORIGIN=http://*.localhost:8000
