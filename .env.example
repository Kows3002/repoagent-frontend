# Development: Vite forwards /jobs and /auth to your local backend.
API_PROXY_TARGET=http://127.0.0.1:8000

# Direct connection to the Render API (used for /auth and /jobs).
# The API must allow the frontend origin and cross-site session cookies.
VITE_API_URL=https://repoagent.onrender.com
# For the local API via Vite's proxy, set VITE_API_URL= instead.
# VITE_API_BASE_URL is still accepted when VITE_API_URL is not defined.

# Must match the backend PREVIEW_DOMAIN, PREVIEW_SCHEME, and PREVIEW_PORT.
# Production example: https://*.preview.example.com
VITE_PREVIEW_ORIGIN=http://*.localhost:8000
